{
  "name": "riddl-vscode",
  "displayName": "RIDDL Language Support",
  "description": "Language support for RIDDL (Reactive Interface to Domain Definition Language)",
  "version": "0.1.0",
  "publisher": "ossuminc",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ossuminc/riddl-vscode"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "riddl",
    "ddd",
    "domain-driven-design",
    "reactive",
    "dsl"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onLanguage:riddl"
  ],
  "contributes": {
    "languages": [
      {
        "id": "riddl",
        "aliases": [
          "RIDDL",
          "riddl"
        ],
        "extensions": [
          ".riddl"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/riddl-icon.png",
          "dark": "./icons/riddl-icon.png"
        }
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "macro",
        "description": "Readability words (is, of, by, etc.)"
      }
    ],
    "semanticTokenScopes": [
      {
        "scopes": {
          "macro": [
            "keyword.other.riddl"
          ]
        }
      }
    ],
    "grammars": [
      {
        "language": "riddl",
        "scopeName": "source.riddl",
        "path": "./syntaxes/riddl.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "riddl.showInfo",
        "title": "RIDDL: Show Info"
      },
      {
        "command": "riddl.info",
        "title": "RIDDL: Version Information"
      },
      {
        "command": "riddl.parse",
        "title": "RIDDL: Parse Current File"
      },
      {
        "command": "riddl.validate",
        "title": "RIDDL: Validate Current File"
      },
      {
        "command": "riddl.translate",
        "title": "RIDDL: Translate to Output Format"
      },
      {
        "command": "riddl.mcp.toggleConnection",
        "title": "RIDDL MCP: Toggle Connection"
      },
      {
        "command": "riddl.mcp.showOutput",
        "title": "RIDDL MCP: Show Output"
      },
      {
        "command": "riddl.mcp.validate",
        "title": "RIDDL MCP: Validate Current File"
      },
      {
        "command": "riddl.mcp.validatePartial",
        "title": "RIDDL MCP: Validate Partial Model"
      },
      {
        "command": "riddl.mcp.checkCompleteness",
        "title": "RIDDL MCP: Check Completeness"
      },
      {
        "command": "riddl.mcp.checkSimulability",
        "title": "RIDDL MCP: Check Simulability"
      },
      {
        "command": "riddl.mcp.explainError",
        "title": "RIDDL MCP: Explain Error"
      },
      {
        "command": "riddl.mcp.suggestNext",
        "title": "RIDDL MCP: Suggest Next Steps"
      },
      {
        "command": "riddl.mcp.generateRiddl",
        "title": "RIDDL MCP: Generate RIDDL from Description"
      }
    ],
    "configuration": {
      "title": "RIDDL",
      "properties": {
        "riddl.mcp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable MCP server integration for AI-assisted features"
        },
        "riddl.mcp.serverUrl": {
          "type": "string",
          "default": "http://localhost:8080",
          "description": "URL of the RIDDL MCP server"
        },
        "riddl.mcp.apiKey": {
          "type": "string",
          "default": "",
          "description": "API key for MCP server authentication (optional)"
        },
        "riddl.mcp.autoConnect": {
          "type": "boolean",
          "default": true,
          "description": "Automatically connect to MCP server when opening RIDDL files"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "^18.x",
    "@types/vscode": "^1.75.0",
    "@typescript-eslint/eslint-plugin": "^5.53.0",
    "@typescript-eslint/parser": "^5.53.0",
    "@vscode/test-electron": "^2.2.3",
    "@vscode/vsce": "^2.18.0",
    "eslint": "^8.34.0",
    "glob": "^13.0.0",
    "mocha": "^10.2.0",
    "typescript": "^4.9.5"
  },
  "dependencies": {
    "@ossuminc/riddl-lib": "file:../riddl/npm-packages/ossuminc-riddl-lib-1.1.1-1-7bc49bb2-20260120-1709.tgz"
  }
}
